{
  "_meta": {
    "api": "FCM HTTP v1 (https://fcm.googleapis.com/v1/projects/{PROJECT_ID}/messages:send)",
    "auth": "OAuth2 bearer token from service account",
    "notes": [
      "Each example shows the `message` body posted to FCM.",
      "`data` values must be strings (FCM constraint). Parse JSON on client.",
      "`android.notification.channel_id` references channels the client creates at install.",
      "`apns.headers.apns-priority: 10` for immediate, 5 for power-conserving.",
      "`interruption-level: time-sensitive` (iOS 15+) bypasses Focus modes including Driving Focus.",
      "`interruption-level: critical` requires Critical Alerts entitlement from Apple."
    ]
  },

  "LOW_BALANCE": {
    "message": {
      "token": "{DEVICE_FCM_TOKEN}",
      "notification": {
        "title": "Low FASTag balance — plaza ahead",
        "body": "Kherki Daula in 5 km. Balance ₹40, toll ₹120. Recharge now to avoid blacklist."
      },
      "data": {
        "type": "LOW_BALANCE",
        "plaza_id": "KHE001",
        "plaza_name": "Kherki Daula",
        "distance_km": "5.0",
        "current_balance": "40",
        "expected_toll": "120",
        "shortfall": "80",
        "deeplink": "fastag://recharge?plaza=KHE001&amount=200",
        "i18n_key": "alert.low_balance",
        "i18n_args": "{\"amount\":\"120\",\"plaza\":\"Kherki Daula\",\"balance\":\"40\"}",
        "sent_at": "2026-05-24T14:32:11Z",
        "alert_id": "alrt_01HXYZ123"
      },
      "android": {
        "priority": "HIGH",
        "ttl": "600s",
        "notification": {
          "channel_id": "plaza_alerts_high",
          "click_action": "OPEN_RECHARGE",
          "color": "#E53935",
          "icon": "ic_notification_warning",
          "tag": "low_balance_KHE001",
          "notification_priority": "PRIORITY_MAX",
          "visibility": "PUBLIC",
          "default_sound": true,
          "default_vibrate_timings": true
        }
      },
      "apns": {
        "headers": {
          "apns-priority": "10",
          "apns-push-type": "alert",
          "apns-collapse-id": "low_balance_KHE001"
        },
        "payload": {
          "aps": {
            "alert": {
              "title": "Low FASTag balance — plaza ahead",
              "body": "Kherki Daula in 5 km. Balance ₹40, toll ₹120. Recharge now."
            },
            "sound": "default",
            "badge": 1,
            "interruption-level": "time-sensitive",
            "relevance-score": 1.0,
            "category": "PLAZA_ALERT"
          }
        }
      }
    }
  },

  "BLACKLISTED": {
    "message": {
      "token": "{DEVICE_FCM_TOKEN}",
      "notification": {
        "title": "FASTag BLACKLISTED — do not approach plaza",
        "body": "Your tag is blacklisted. Toll plaza will reject. Resolve immediately or use cash lane."
      },
      "data": {
        "type": "BLACKLISTED",
        "tag_id": "34161FA8201234567890ABCD",
        "reason_code": "INSUFFICIENT_KYC",
        "reason_text": "KYC documents not updated since 2024-12",
        "plaza_id": "KHE001",
        "distance_km": "5.0",
        "deeplink": "fastag://tag-status?reason=INSUFFICIENT_KYC",
        "i18n_key": "alert.blacklisted",
        "i18n_args": "{\"reason\":\"KYC\"}",
        "alert_id": "alrt_01HXYZ124",
        "severity": "critical"
      },
      "android": {
        "priority": "HIGH",
        "ttl": "300s",
        "notification": {
          "channel_id": "safety_critical",
          "color": "#B71C1C",
          "icon": "ic_notification_blocked",
          "tag": "blacklist_alert",
          "notification_priority": "PRIORITY_MAX",
          "visibility": "PUBLIC",
          "default_sound": true,
          "default_vibrate_timings": true,
          "sticky": true
        }
      },
      "apns": {
        "headers": {
          "apns-priority": "10",
          "apns-push-type": "alert"
        },
        "payload": {
          "aps": {
            "alert": {
              "title": "FASTag BLACKLISTED",
              "body": "Plaza in 5 km will reject your tag. Use cash lane or resolve now."
            },
            "sound": {
              "critical": 1,
              "name": "default",
              "volume": 1.0
            },
            "badge": 1,
            "interruption-level": "critical",
            "relevance-score": 1.0,
            "category": "SAFETY_CRITICAL"
          }
        }
      }
    }
  },

